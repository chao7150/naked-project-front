{
  "name": "house-temperature-web",
  "version": "1.0.0",
  "scripts": {
    "build": "yarn build:client && cp src/ui/index.html dist/index.html",
    "build:client": "webpack --config webpack.config.js",
    "start:client": "webpack-dev-server --config webpack.config.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write"
  },
  "author": "Satoru Yokoyama <22640673+chao7150@users.noreply.github.com>",
  "license": "MIT",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "temporal-polyfill": "^1.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "css-loader": "^7.1.4",
    "esbuild-loader": "^4.5.0",
    "style-loader": "^4.0.0",
    "typescript": "^7.0.2",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  },
  "packageManager": "yarn@4.2.2"
}
